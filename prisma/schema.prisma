generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (unpooled) connection: connection poolers such as Neon's
  // don't reliably support the advisory lock prisma migrate takes. Locally both
  // variables point at the same Docker database.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Instructor-only for now; kept as an enum so further roles can be added by migration.
enum Role {
  INSTRUCTOR
}

enum QuestionSource {
  MANUAL
  AI
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExamStatus {
  DRAFT
  FINAL
}

// Keep in sync with src/lib/majors.ts.
enum Major {
  MATHEMATICS
  COMPUTER_SCIENCE
  PHYSICS
  CHEMISTRY
  BIOLOGY
  ENGINEERING
  MEDICINE
  PHARMACY
  BUSINESS
  ECONOMICS
  LANGUAGES
  EDUCATION
  PSYCHOLOGY
  LAW
  ARTS
}

enum Degree {
  BACHELOR
  MASTER
  DOCTORATE
  OTHER
}

enum Visibility {
  PRIVATE
  SHARED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(INSTRUCTOR)
  // Instructor profile, collected at sign-up. Nullable because accounts created
  // before sign-up asked for it have none; the register API requires all of it.
  // Shared questions are reviewed only by another instructor with the same major.
  major        Major?
  degree       Degree?
  university   String?
  courses      String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curricula         Curriculum[]
  questionsCreated  Question[]     @relation("QuestionCreatedBy")
  questionsApproved Question[]     @relation("QuestionApprovedBy")
  questionsRejected Question[]     @relation("QuestionRejectedBy")
  exams             Exam[]
  aiGenerations     AiGeneration[]

  @@map("users")
}

model Curriculum {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User           @relation(fields: [createdById], references: [id])
  chapters      Chapter[]
  questions     Question[]
  exams         Exam[]
  aiGenerations AiGeneration[]

  @@map("curricula")
}

model Chapter {
  id           String   @id @default(cuid())
  curriculumId String
  title        String
  // Position of the chapter inside its curriculum (1, 2, 3...).
  orderIndex   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@unique([curriculumId, orderIndex])
  @@unique([curriculumId, title])
  // Target of the questions(chapterId, curriculumId) foreign key.
  @@unique([id, curriculumId])
  @@map("chapters")
}

// Range and consistency rules are also enforced by CHECK constraints in
// migration 20261019120000_db_integrity_checks (Prisma's schema language can't express them).
model Question {
  id                   String         @id @default(cuid())
  content              String
  // Optional answer choices for multiple-choice questions; null for open-ended ones.
  options              Json?
  answer               String
  curriculumId         String
  chapterId            String
  difficulty           Int
  estimatedTimeMinutes Int
  source               QuestionSource @default(MANUAL)
  createdById          String
  status               QuestionStatus @default(PENDING)
  approvedById         String?
  approvedAt           DateTime?
  rejectionReason      String?
  rejectedById         String?
  rejectedAt           DateTime?
  visibility           Visibility     @default(PRIVATE)
  timesUsed            Int            @default(0)
  lastUsedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  curriculum     Curriculum     @relation(fields: [curriculumId], references: [id])
  // Composite key: the database itself guarantees the chapter belongs to the question's curriculum.
  chapter        Chapter        @relation(fields: [chapterId, curriculumId], references: [id, curriculumId])
  createdBy      User           @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  approvedBy     User?          @relation("QuestionApprovedBy", fields: [approvedById], references: [id])
  rejectedBy     User?          @relation("QuestionRejectedBy", fields: [rejectedById], references: [id])
  examEntries    ExamQuestion[]
  // Set for AI-written questions: the generation run that produced the draft.
  aiGenerationId String?
  aiGeneration   AiGeneration?  @relation(fields: [aiGenerationId], references: [id], onDelete: SetNull)

  @@index([curriculumId, chapterId])
  @@index([status, visibility])
  @@index([createdById])
  @@index([difficulty])
  @@map("questions")
}

// A generated exam. It starts as a DRAFT the instructor can edit; FINAL locks it
// and counts its questions as used (questions.timesUsed / lastUsedAt).
// Ranges and status consistency are enforced by CHECK constraints in migration 20261124150000_exams.
model Exam {
  id               String     @id @default(cuid())
  title            String
  curriculumId     String
  // Chapters the exam was generated from; questions may only come from these.
  chapterIds       String[]
  // 1..5 aims for that level (questions within one level of it); null means a mixed spread.
  targetDifficulty Int?
  durationMinutes  Int
  status           ExamStatus @default(DRAFT)
  // Notes from the last generation, e.g. "Only 35 of 60 minutes could be filled".
  warnings         String[]   @default([])
  createdById      String
  finalizedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  curriculum Curriculum     @relation(fields: [curriculumId], references: [id])
  createdBy  User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  questions  ExamQuestion[]

  @@index([createdById, createdAt])
  @@map("exams")
}

model ExamQuestion {
  examId     String
  questionId String
  // 1-based order in the exam.
  position   Int

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@id([examId, questionId])
  @@index([questionId])
  @@map("exam_questions")
}

// One call to Claude for question drafts. Kept for traceability (who asked for what,
// which model, token usage) and so that only drafts that really came from a generation
// can be saved as AI-generated questions.
model AiGeneration {
  id             String   @id @default(cuid())
  createdById    String
  curriculumId   String
  chapterId      String
  // The instructor's request: count, difficulty, type, focus, visibility.
  params         Json
  model          String
  // The validated drafts Claude returned.
  drafts         Json
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  // How many drafts have been saved as questions (never more than were generated).
  submittedCount Int      @default(0)
  createdAt      DateTime @default(now())

  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  questions  Question[]

  @@index([createdById, createdAt])
  @@map("ai_generations")
}
