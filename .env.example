# Copy to .env and adjust. Never commit the real .env.

DATABASE_URL="postgresql://capstone:capstone@localhost:5434/question_bank?schema=public"

# Secret used to sign login tokens. Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Anyone registering as an instructor must provide this code.
INSTRUCTOR_INVITE_CODE="change-me"
