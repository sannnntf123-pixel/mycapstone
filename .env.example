# Copy to .env and adjust. Never commit the real .env.
# The server validates these at startup and refuses to start if any are missing or too weak.

DATABASE_URL="postgresql://capstone:capstone@localhost:5434/question_bank?schema=public"

# Secret used to sign login tokens (min 32 chars). Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-of-32+-chars"
JWT_EXPIRES_IN="8h"

# Everyone registering must provide this code (min 8 chars).
INSTRUCTOR_INVITE_CODE="change-me-please"

# Failed login / invite-code attempts allowed per window before HTTP 429.
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15

# "true" only when deployed behind a proxy that sets X-Forwarded-For (Vercel, nginx).
# Otherwise the header can be faked, so invite-code attempts share one counter.
TRUST_PROXY=false

# Password for the demo instructor accounts created by `npm run db:seed` (dev only).
SEED_PASSWORD="change-me-demo-password"
